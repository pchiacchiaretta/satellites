# =========================
# ERA5 downloader settings
# =========================

# CDS dataset per ERA5 hourly single levels
ERA5_DATASET=reanalysis-era5-single-levels
ERA5_PRODUCT_TYPE=reanalysis

# Periodo richiesto (inclusivo)
ERA5_START_YEAR=2014
ERA5_START_MONTH=1
ERA5_END_YEAR=2026
ERA5_END_MONTH=12

# Bounding box Europa [north, west, south, east]
ERA5_AREA=72,-25,34,45

# Dove salvare i file scaricati
ERA5_OUTPUT_DIR=/home/manager/storage/atmo/sftpgo/inbound/raw_data/satellites/copernicus/era5

# Formato output: grib oppure netcdf
ERA5_FILE_FORMAT=netcdf

# Lista variabili ERA5 (CDS names), separate da virgola
ERA5_VARIABLES=2m_temperature,10m_u_component_of_wind,10m_v_component_of_wind,convective_precipitation,convective_rain_rate,instantaneous_10m_wind_gust,k_index,precipitation_type,total_cloud_cover,total_column_ozone,total_column_rain_water,total_column_snow_water,total_column_supercooled_liquid_water,total_column_water,total_column_water_vapour,total_precipitation

# Retry e controllo flusso
ERA5_MAX_RETRIES=3
ERA5_RETRY_WAIT_SECONDS=25
ERA5_REQUEST_PAUSE_SECONDS=2
ERA5_THROTTLE_RETRY_WAIT_SECONDS=120
ERA5_THROTTLE_MAX_WAIT_SECONDS=900
ERA5_ADAPTIVE_PAUSE_ENABLED=true
ERA5_ADAPTIVE_PAUSE_INCREMENT_SECONDS=2
ERA5_ADAPTIVE_PAUSE_DECREMENT_SECONDS=0.5
ERA5_ADAPTIVE_PAUSE_MAX_SECONDS=30
ERA5_SKIP_EXISTING=true
ERA5_DRY_RUN=false

# Logging e controlli download
# Se vuoto, usa: <ERA5_OUTPUT_DIR>/era5_downloader.log
ERA5_LOG_FILE=
ERA5_LOG_LEVEL=INFO
ERA5_VERIFY_DOWNLOAD_MAGIC=true
# Se vuoto, usa: <ERA5_OUTPUT_DIR>/era5_report.csv
ERA5_REPORT_FILE=

# Credenziali CDS API
# CDSAPI_URL e' facoltativa (default: https://cds.climate.copernicus.eu/api)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=__PUT_YOUR_CDS_API_KEY_HERE__

# =========================
# CAMS EAC4 downloader settings
# =========================

# ADS dataset CAMS global reanalysis EAC4
CAMS_DATASET=cams-global-reanalysis-eac4

# Periodo richiesto (inclusivo)
CAMS_START_YEAR=2003
CAMS_START_MONTH=1
CAMS_END_YEAR=2025
CAMS_END_MONTH=12

# Bounding box Europa [north, west, south, east]
CAMS_AREA=72,-25,34,45

# Dove salvare i file scaricati
CAMS_OUTPUT_DIR=/home/manager/storage/atmo/sftpgo/inbound/raw_data/satellites/copernicus/cams_eac4

# Formato output: grib, netcdf, netcdf_zip
# Nota: netcdf viene normalizzato a netcdf_zip.
CAMS_FILE_FORMAT=netcdf

# Tipo livelli: single, model, pressure, all
CAMS_LEVEL_TYPE=single

# Variabili da scaricare:
# - all: tutte quelle disponibili nel profilo selezionato
# - oppure lista separata da virgola
CAMS_VARIABLES=all

# Livelli opzionali (usati solo per i profili multi-level)
# Se vuoti vengono usati tutti i livelli disponibili del profilo.
CAMS_MODEL_LEVELS=
CAMS_PRESSURE_LEVELS=

# Time steps EAC4 (default ufficiale: 3-hourly)
CAMS_TIME_STEPS=00:00,03:00,06:00,09:00,12:00,15:00,18:00,21:00

# Retry e controllo flusso
CAMS_MAX_RETRIES=3
CAMS_RETRY_WAIT_SECONDS=25
CAMS_REQUEST_PAUSE_SECONDS=2
CAMS_THROTTLE_RETRY_WAIT_SECONDS=120
CAMS_THROTTLE_MAX_WAIT_SECONDS=900
CAMS_ADAPTIVE_PAUSE_ENABLED=true
CAMS_ADAPTIVE_PAUSE_INCREMENT_SECONDS=2
CAMS_ADAPTIVE_PAUSE_DECREMENT_SECONDS=0.5
CAMS_ADAPTIVE_PAUSE_MAX_SECONDS=30
CAMS_SKIP_EXISTING=true
CAMS_DRY_RUN=false

# Logging e controlli download
# Se vuoto, usa: <CAMS_OUTPUT_DIR>/cams_eac4_downloader.log
CAMS_LOG_FILE=
CAMS_LOG_LEVEL=INFO
CAMS_VERIFY_DOWNLOAD_MAGIC=true
# Se vuoto, usa: <CAMS_OUTPUT_DIR>/cams_eac4_report.csv
CAMS_REPORT_FILE=

# Credenziali ADS API (priorita' rispetto a CDSAPI_*)
CAMSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CAMSAPI_KEY=__PUT_YOUR_ADS_API_KEY_HERE__
